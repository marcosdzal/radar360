<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentinel/db" VERSION="20240101" COMMENT="XMLDB file for Moodle local/sentinel"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_sentinel_map" COMMENT="Maps rubric rows to grade book categories">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="rubric_row_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the rubric row"/>
        <FIELD NAME="grade_category_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the grade book category"/>
        <FIELD NAME="grade_item_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="ID of the grade item for this rubric row"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_rubric_row_id" TYPE="unique" FIELDS="rubric_row_id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_grade_item_id" UNIQUE="false" FIELDS="grade_item_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_student_photo" COMMENT="Stores teacher-uploaded photos for students">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="studentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The student's userid"/>
        <FIELD NAME="uploaderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Who uploaded the photo"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last modification timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_studentid" TYPE="unique" FIELDS="studentid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_uploaderid" UNIQUE="false" FIELDS="uploaderid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_descriptor" COMMENT="LOMLOE profile exit descriptors (RD 217/2022)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="Descriptor code, e.g. CCL1"/>
        <FIELD NAME="area" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="Competency area, e.g. CCL"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_code" TYPE="unique" FIELDS="code"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_area" UNIQUE="false" FIELDS="area"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_ce_descriptor" COMMENT="Maps rubric criteria (CE) to LOMLOE descriptors (legacy)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="criteriaid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="gradingform_rubric_criteria.id"/>
        <FIELD NAME="descriptorcode" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="local_sentinel_descriptor.code"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_criteria_descriptor" TYPE="unique" FIELDS="criteriaid, descriptorcode"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_criteriaid" UNIQUE="false" FIELDS="criteriaid"/>
        <INDEX NAME="ix_descriptorcode" UNIQUE="false" FIELDS="descriptorcode"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_cat_descriptor" COMMENT="Maps gradebook CE categories to LOMLOE profile exit descriptors">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="grade_category_id" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="grade_categories.id (the CE-level category)"/>
        <FIELD NAME="descriptorcode" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="local_sentinel_descriptor.code"/>
        <FIELD NAME="source" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="manual" COMMENT="normativa or manual"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_cat_descriptor" TYPE="unique" FIELDS="grade_category_id, descriptorcode"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_grade_category_id" UNIQUE="false" FIELDS="grade_category_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_period" COMMENT="Configurable communication periods for the competency report">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="0 = site-wide default"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="label" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="cutoffdate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Unix timestamp; 0 = no cutoff"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_selfeval" COMMENT="Student self-assessment (DUA): mirrors the teacher rubric for metacognitive reflection">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The student who self-assessed"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course module (assign) where the rubric lives"/>
        <FIELD NAME="criterionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="gradingform_rubric_criteria.id"/>
        <FIELD NAME="levelid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="gradingform_rubric_levels.id chosen by student"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_user_cm_crit" TYPE="unique" FIELDS="userid, cmid, criterionid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="ix_cmid" UNIQUE="false" FIELDS="cmid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_selfeval_config" COMMENT="Per-activity self-assessment configuration: whether student self-assessment is required">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="course_modules.id (the assign activity)"/>
        <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = student must self-assess before seeing teacher grade"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uq_cmid" TYPE="unique" FIELDS="cmid"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_sentinel_dua_note" COMMENT="DUA logbook: chronological pedagogical observations per student/course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Student user id"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course id"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Teacher who wrote the note"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" COMMENT="HTML content of the observation"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_dua_motiv" COMMENT="DUA motivation keys: student interests and teacher pedagogical hooks">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Student user id"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course id"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Who created this entry (student or teacher)"/>
        <FIELD NAME="category" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="interest" COMMENT="interest or hook"/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Tag/chip text"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_dua_acis" COMMENT="DUA significant curricular adaptations (ACIS/ACS) per student/criterion">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Student user id"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course id"/>
        <FIELD NAME="criterionid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="gradingform_rubric_criteria.id or CE category id"/>
        <FIELD NAME="original_text" TYPE="text" NOTNULL="true" COMMENT="Original normative criterion text"/>
        <FIELD NAME="adapted_text" TYPE="text" NOTNULL="true" COMMENT="Adapted criterion text for the student"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Teacher who created the adaptation"/>
        <FIELD NAME="datestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Start date of the ACIS"/>
        <FIELD NAME="dateend" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" COMMENT="Optional end date"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="ix_criterionid" UNIQUE="false" FIELDS="criterionid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sentinel_dua_access" COMMENT="DUA access adaptations (AA): organizational/format accommodations per student">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Student user id"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course id (0 = site-wide)"/>
        <FIELD NAME="measure" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Accessibility measure text"/>
        <FIELD NAME="catalog" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1 = from official catalog, 0 = custom"/>
        <FIELD NAME="subcategory" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="custom" COMMENT="standard, program or custom"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" COMMENT="1 = active, 0 = deactivated"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Teacher who added this measure"/>
        <FIELD NAME="datestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Start date"/>
        <FIELD NAME="dateend" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" COMMENT="Optional end date"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ix_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
